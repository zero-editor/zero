{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zero",
  "version": "../package.json",
  "identifier": "com.vidtopolovec.zero",
  "build": {
    "beforeDevCommand": "sh scripts/build-helper.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/build-helper.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "zero",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": { "x": 9, "y": 34 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 https://api.github.com; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMjJGMjU0NTczNDM1NUEKUldSYU5UUlhWUElpd2VrdXFoZEEwT2loR3d5TGtKaXBFdG55NjJpNmNrU3NhVmdMUTBiTm5vNE8K",
      "endpoints": [
        "https://github.com/zero-editor/zero/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "externalBin": ["binaries/zero-voice"],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
